{
    "ts-node": {
        "compilerOptions": {
            "module": "commonjs"
        }
    },
    "compilerOptions": {
        "target": "es2019",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "declaration": true,
        "allowJs": false,
        "noEmit": true,
        "types": ["jasmine", "node", "uuid"]
    },
    "include": ["src/**/*", "spec/**/*"],
    "exclude": ["node_modules"]
}
